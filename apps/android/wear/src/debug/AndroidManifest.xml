<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application>
        <!-- Debug-only adb target with an app-scoped task. Release variants never merge it. -->
        <activity
            android:name=".WearScreenshotActivity"
            android:exported="true"
            android:taskAffinity="${applicationId}.screenshot"
            tools:ignore="ExportedActivity" />
    </application>
</manifest>
